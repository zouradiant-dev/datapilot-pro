# Copy to .env; replace every CHANGE_ME password. Never commit .env.
POSTGRES_DB=datapilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_ADMIN
POSTGRES_PORT=55432
DATAPILOT_OWNER_PASSWORD=CHANGE_ME_OWNER
DATAPILOT_SEED_PASSWORD=CHANGE_ME_SEED
DATAPILOT_READER_PASSWORD=CHANGE_ME_READER
DATAPILOT_INGEST_PASSWORD=CHANGE_ME_INGEST
DATAPILOT_UPLOAD_READER_PASSWORD=CHANGE_ME_UPLOAD_READER
DATAPILOT_REGISTRY_PASSWORD=CHANGE_ME_REGISTRY
DATAPILOT_RUNTIME_PASSWORD=CHANGE_ME_RUNTIME
DATAPILOT_CHECKPOINT_OWNER_PASSWORD=CHANGE_ME_CHECKPOINT_OWNER
# URL-encode special characters in DSN passwords.
DATAPILOT_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_ADMIN@127.0.0.1:55432/datapilot
DATAPILOT_OWNER_DATABASE_URL=postgresql+psycopg://datapilot_owner:CHANGE_ME_OWNER@127.0.0.1:55432/datapilot
DATAPILOT_SEED_DATABASE_URL=postgresql+psycopg://datapilot_seed:CHANGE_ME_SEED@127.0.0.1:55432/datapilot
DATAPILOT_READER_DATABASE_URL=postgresql+psycopg://datapilot_reader:CHANGE_ME_READER@127.0.0.1:55432/datapilot
DATAPILOT_INGEST_DATABASE_URL=postgresql+psycopg://datapilot_ingest:CHANGE_ME_INGEST@127.0.0.1:55432/datapilot
DATAPILOT_UPLOAD_READER_DATABASE_URL=postgresql+psycopg://datapilot_upload_reader:CHANGE_ME_UPLOAD_READER@127.0.0.1:55432/datapilot
DATAPILOT_REGISTRY_DATABASE_URL=postgresql+psycopg://datapilot_registry:CHANGE_ME_REGISTRY@127.0.0.1:55432/datapilot
DATAPILOT_RUNTIME_DATABASE_URL=postgresql+psycopg://datapilot_runtime:CHANGE_ME_RUNTIME@127.0.0.1:55432/datapilot
DATAPILOT_CHECKPOINT_OWNER_DATABASE_URL=postgresql+psycopg://datapilot_checkpoint_owner:CHANGE_ME_CHECKPOINT_OWNER@127.0.0.1:55432/datapilot
DATAPILOT_LLM_MODE=live
DATAPILOT_MODEL_PROVIDER=openai_compatible
DATAPILOT_API_KEY=
DATAPILOT_BASE_URL=https://api.openai.com/v1
DATAPILOT_MODEL=
# DeepSeek profile: change provider to deepseek, base URL to https://api.deepseek.com,
# model to deepseek-flash; set your key only in the ignored .env. Thinking is disabled.
DATAPILOT_MODEL_TIMEOUT_SECONDS=30
DATAPILOT_QUERY_TIMEOUT_SECONDS=2
DATAPILOT_MCP_TIMEOUT_SECONDS=10
DATAPILOT_MAX_MODEL_CALLS=8
DATAPILOT_MAX_INPUT_CHARS=16000
DATAPILOT_MAX_CONTEXT_TOKENS=18000
DATAPILOT_MAX_TOOL_VIEW_CHARS=4096
DATAPILOT_CONTEXT_COMPRESSION=true
DATAPILOT_CONTEXT_TRIGGER_RATIO=0.8
DATAPILOT_CONTEXT_KEEP_BATCHES=2
DATAPILOT_CONTEXT_IDLE_SECONDS=300
DATAPILOT_CONTEXT_ALLOW_SUMMARY=true
DATAPILOT_MAX_OUTPUT_TOKENS=1200
DATAPILOT_MAX_TOTAL_TOKENS=18000
DATAPILOT_MAX_SQL_ATTEMPTS=2
DATAPILOT_MAX_STEPS=20
DATAPILOT_MAX_ROWS=100
DATAPILOT_MAX_TASKS=8
DATAPILOT_MAX_PARALLEL_WORKERS=2
DATAPILOT_MAX_WORKER_TURNS=4
DATAPILOT_MAX_REPLANS=1
DATAPILOT_RAG_INGEST_DATABASE_URL=postgresql+psycopg://datapilot_rag_ingest:CHANGE_ME_RAG_INGEST@127.0.0.1:55432/datapilot
DATAPILOT_RAG_INGEST_PASSWORD=CHANGE_ME_RAG_INGEST
DATAPILOT_RAG_READER_DATABASE_URL=postgresql+psycopg://datapilot_rag_reader:CHANGE_ME_RAG_READER@127.0.0.1:55432/datapilot
DATAPILOT_RAG_READER_PASSWORD=CHANGE_ME_RAG_READER
DATAPILOT_WEB_DATABASE_URL=postgresql+psycopg://datapilot_web:CHANGE_ME_WEB@127.0.0.1:55432/datapilot
DATAPILOT_WEB_PASSWORD=CHANGE_ME_WEB
DATAPILOT_MAINTENANCE_DATABASE_URL=postgresql+psycopg://datapilot_maintenance:CHANGE_ME_MAINTENANCE@127.0.0.1:55432/datapilot
DATAPILOT_MAINTENANCE_PASSWORD=CHANGE_ME_MAINTENANCE
