  "new_state_necessity": {
    "table": "execution.web_smoke_admissions",
    "why": "one durable row per owner/case is required to prevent a failed/new-message retry from creating a second Run after restart; existing web_requests has no owner+case uniqueness and retention can retire it",
    "columns": [
      "owner,case_id PK",
      "permit_sha256/freeze_sha256 for revocation/drift",
      "request_sha256/message_id for same-request idempotency",
      "goal_contract_sha256 for audit binding",
      "run_id UNIQUE for one Run per case",
      "binding JSONB for exact scope audit",
      "admitted_at/expires_at for campaign bound"
    ],
    "no_new_ledger": "three admitted Runs x original per-Run 8 calls/18,000 units is the 24/54,000 global ceiling; no second global budget ledger"
  },
  "admission_semantics": {
    "permit_trust": "only the trusted operator starts the private HostPolicy with smoke_admission_file; the permit is HMAC-signed with DATAPILOT_SMOKE_ADMISSION_KEY, which is not in the host file, browser, model or MCP env; approved_by_role and source approval ref are inside the signed body",
    "one_run_per_case": "PRIMARY KEY(owner,case_id); second message for same case rejected; failed case cannot be retried with a new key",
    "same_request_retry": "same request SHA + message returns the original run; no new command",
    "fourth_or_replacement": "only exactly 3 signed cases match; fourth request/other dataset/version/corpus rejected",
    "owner_scope": "owner, question SHA, metric/semantic/dataset, full window, report/rag policy, corpus/index/document and required-fact bindings checked against payload",
    "expiry_stop": "permit expiry and STOP file checked on every gate; permit hash change rejects existing Run; campaign 1800s is shared from min(admitted_at) for the permit",
    "restart": "admission row is committed with the original Web transaction; restart re-reads the row and permit",
    "unknown": "existing run/ledger unknown-outcome handling remains; admission never creates a replacement Run",
    "normal_fake": "gate disabled when smoke_admission_file is absent; existing Fake tests pass",
    "limits": "per-Run wall-clock 180s is an authorization/stop condition, not a hard process-kill wall clock; existing 30s provider timeout and step/SQL limits remain"
  },
